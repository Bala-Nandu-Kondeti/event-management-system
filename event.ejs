<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>College Events</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
body { background: #f4f6fb; }
.events-header { background: #1f4fd8; color: white; padding: 20px; border-radius: 8px; margin-bottom: 30px; }
.event-card { border-radius: 12px; border: none; overflow: hidden; height: 100%; }
.event-card img { height: 180px; width: 100%; object-fit: cover; }
.event-date { font-size: 13px; color: #666; }
</style>
</head>
<body>

<div class="container mt-4">
  <div class="events-header d-flex justify-content-between align-items-center">
    <h3 class="mb-0">College Events</h3>
    <input type="text" class="form-control w-25" placeholder="Search events">
  </div>

  <div class="row g-4">
    <% events.forEach(event => { %>
      <div class="col-md-4 col-sm-6">
        <div class="card event-card">
          <img src="/uploads/<%= event.image %>">
          <div class="card-body">
            <h5><%= event.title %></h5>
            <p><%= event.description %></p>
            <div class="event-date">📅 <%= event.event_date %> · <%= event.event_time %></div>

            <% if (isAdmin) { %>
              <a href="/edit/<%= event.id %>" class="btn btn-warning btn-sm mt-2">Edit</a>
              <a href="/delete/<%= event.id %>" class="btn btn-danger btn-sm mt-2">Delete</a>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

</body>
</html>